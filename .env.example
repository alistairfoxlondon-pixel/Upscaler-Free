# No variables are needed for faithful Sharp/libvips upscaling.
# Real-ESRGAN AI is shown only when a private GPU worker is deployed.
REAL_ESRGAN_URL=
REAL_ESRGAN_API_KEY=

# Optional: image-specific Stock metadata is generated automatically on upload when configured.
# Uploaded images are sent to the configured vision provider for this feature.
# Keep secrets server-side; never prefix them with VITE_.
OPENAI_API_KEY=
STOCK_METADATA_MODEL=gpt-4o-mini

{
  "name": "open-upscale",
  "private": true,
  "version": "1.0.0",
  "description": "A privacy-first, open-source cloud image upscaler for Vercel and Node.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "tsx scripts/quality-benchmark.mts",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
